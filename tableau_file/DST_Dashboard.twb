      <aliases enabled='yes' />
      <column caption='Flight Status' datatype='string' name='[Calculation_1500894021853184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [cancelled] = 1 THEN &quot;Cancelled&quot;&#13;&#10;ELSEIF [diverted] = 1 THEN &quot;Diverted&quot;&#13;&#10;ELSEIF [arr_delay] &lt;= 14 THEN &quot;On-Time&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='Is On-Time' datatype='integer' name='[Calculation_1500894022000641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [cancelled] = 0 AND [diverted] = 0 AND [arr_delay] &lt;= 14 THEN 1 ELSE 0 END' />
      </column>
      <column caption='OTP %' datatype='real' default-format='p0.0%' name='[Calculation_1500894022144002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1500894022000641]) / SUM(IF [cancelled] = 0 AND [diverted] = 0 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Cancellation Rate %' datatype='real' default-format='p0.00%' name='[Calculation_1500894022463491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cancelled]) / COUNT([fl_date])' />
      </column>
      <column caption='Delay Severity Band' datatype='string' name='[Calculation_1500894022696964]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [cancelled] = 1 THEN &quot;Cancelled&quot;&#13;&#10;ELSEIF [diverted] = 1 THEN &quot;Diverted&quot;&#13;&#10;ELSEIF [arr_delay] &lt;= 14 THEN &quot;On-Time (≤14 min)&quot;&#13;&#10;ELSEIF [arr_delay] &lt;= 45 THEN &quot;Minor Delay (15-45 min)&quot;&#13;&#10;ELSEIF [arr_delay] &lt;= 90 THEN &quot;Moderate Delay (46-90 min)&quot;&#13;&#10;ELSE &quot;Severe Delay (&gt;90 min)&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Departure Hour' datatype='integer' name='[Calculation_1500894045646853]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT([crs_dep_time] / 100)' />
      </column>
      <column caption='Carrier Name' datatype='string' name='[Calculation_1500894079315974]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [op_unique_carrier]&#13;&#10;    WHEN &quot;WN&quot; THEN &quot;Southwest Airlines&quot;&#13;&#10;    WHEN &quot;DL&quot; THEN &quot;Delta Air Lines&quot;&#13;&#10;    WHEN &quot;AA&quot; THEN &quot;American Airlines&quot;&#13;&#10;    WHEN &quot;UA&quot; THEN &quot;United Airlines&quot;&#13;&#10;    WHEN &quot;OO&quot; THEN &quot;SkyWest Airlines&quot;&#13;&#10;    WHEN &quot;YX&quot; THEN &quot;Republic Airways&quot;&#13;&#10;    WHEN &quot;MQ&quot; THEN &quot;Envoy Air&quot;&#13;&#10;    WHEN &quot;B6&quot; THEN &quot;JetBlue Airways&quot;&#13;&#10;    WHEN &quot;OH&quot; THEN &quot;PSA Airlines&quot;&#13;&#10;    WHEN &quot;AS&quot; THEN &quot;Alaska Airlines&quot;&#13;&#10;    WHEN &quot;NK&quot; THEN &quot;Spirit Airlines&quot;&#13;&#10;    WHEN &quot;F9&quot; THEN &quot;Frontier Airlines&quot;&#13;&#10;    WHEN &quot;9E&quot; THEN &quot;Endeavor Air&quot;&#13;&#10;    WHEN &quot;G4&quot; THEN &quot;Allegiant Air&quot;&#13;&#10;    WHEN &quot;HA&quot; THEN &quot;Hawaiian Airlines&quot;&#13;&#10;    ELSE [op_unique_carrier]&#13;&#10;END' />
      </column>
      <column caption='Airborne Delay Recovery' datatype='real' name='[Calculation_1500894100066311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dep_delay] - [arr_delay]' />
      </column>
